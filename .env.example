# =====================================================================
#  Chatbot — LLM provider configuration
#  Copy this file to `.env` and adjust the values:  cp .env.example .env
#  Every provider is reached through the OpenAI-compatible API (/v1).
#  Variables already set in the process environment (docker `environment:`,
#  `export`) take precedence over this file.
# =====================================================================

# --- Active provider -------------------------------------------------
# ollama | lmstudio | llamacpp | openrouter | omniroute | custom
LLM_PROVIDER=ollama

# Providers shown in the UI picker (comma-separated). Empty = all.
LLM_ENABLED_PROVIDERS=ollama,lmstudio,llamacpp,openrouter,omniroute,custom

# --- Generation parameters (initial values; adjustable in the UI) ----
LLM_TEMPERATURE=0.7
# Output token limit. Empty = server default.
LLM_MAX_TOKENS=
# Tool calling (function calling): true/false
LLM_ENABLE_TOOLS=true
LLM_MAX_TOOL_ROUNDS=4
# Show the reasoning block of "thinking" models: true/false
LLM_SHOW_REASONING=true
# Sends `reasoning_effort` (low | medium | high | none). Empty = not sent.
LLM_REASONING_EFFORT=
# Maximum seconds per request (large local models can be slow).
LLM_REQUEST_TIMEOUT=120
LLM_SYSTEM_PROMPT="You are a concise, friendly assistant embedded in a Reflex application. Answer in the user's language. Use markdown, and put code in fenced blocks with a language tag."

# --- UI texts (the interface itself is in Spanish) --------------------
APP_TITLE=Reflex Chatbot
APP_WELCOME_TITLE=¿En qué puedo ayudarte?
APP_WELCOME_SUBTITLE=Chat en streaming con Ollama, LM Studio, llama.cpp, OpenRouter u OmniRoute.

# =====================================================================
#  Per-provider blocks. Variables available for every PREFIX:
#    <PREFIX>_BASE_URL    OpenAI-compatible base URL (ends in /v1)
#    <PREFIX>_API_KEY     key (local servers ignore it)
#    <PREFIX>_MODEL       default model
#    <PREFIX>_MODELS      fixed, comma-separated model list
#                         (when empty, GET /v1/models is queried)
#    <PREFIX>_HEADERS     JSON with extra HTTP headers
#    <PREFIX>_EXTRA_BODY  JSON merged into every request body
#    <PREFIX>_LABEL       name shown in the UI
# =====================================================================

# --- Ollama  (https://ollama.com) — port 11434 ------------------------
# In Docker, with Ollama on the host:   http://host.docker.internal:11434/v1
# With the compose `ollama` service:     http://ollama:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2
# Ollama's /v1 API does not accept `num_ctx`: set the context window on the
# server (OLLAMA_CONTEXT_LENGTH=8192 ollama serve) or with a Modelfile.

# --- LM Studio  (https://lmstudio.ai) — port 1234 ---------------------
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=

# --- llama.cpp  (llama-server) — port 8080 ----------------------------
# Start it with --jinja to enable tool calling.
LLAMACPP_BASE_URL=http://localhost:8080/v1
# Only if llama-server was started with --api-key
LLAMACPP_API_KEY=
LLAMACPP_MODEL=

# --- OpenRouter  (https://openrouter.ai) -------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# OpenRouter lists hundreds of models; pin the ones you want to see:
OPENROUTER_MODELS=openrouter/auto,openai/gpt-4o-mini,anthropic/claude-sonnet-4.5,google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct
# Optional attribution (shown in OpenRouter's rankings)
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Reflex Chatbot

# --- OmniRoute  (https://github.com/diegosouzapw/OmniRoute) — port 20128
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# --- Any other OpenAI-compatible server --------------------------------
# vLLM, LocalAI, Jan, text-generation-webui, LiteLLM, OpenAI, Groq, …
CUSTOM_LABEL=Custom
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_MODELS=

# =====================================================================
#  Docker / docker compose
#  (compose reads this same .env to interpolate variables)
# =====================================================================
# Docker Hub user and image tag
DOCKERHUB_USER=ecrespo
IMAGE_TAG=latest
# Published port (frontend + backend share one port)
PORT=3000
# Only when published on a different port/host or behind a reverse proxy:
# REFLEX_API_URL=https://chat.mydomain.com

# Local server URLs as seen FROM the container.
# host.docker.internal = your machine (already mapped in docker-compose.yml)
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
DOCKER_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
DOCKER_LLAMACPP_BASE_URL=http://host.docker.internal:8080/v1
DOCKER_OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1

# docker-compose.ollama.yml: models to pull (space-separated)
OLLAMA_PULL_MODELS=llama3.2
